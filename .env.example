# Copy this file to .env (same folder) and replace the placeholders. Never commit .env.
# Values already set in your system environment take priority over this file.

# AI gateway key (all agent calls go through Portkey)
PORTKEY_API_KEY=your-portkey-api-key-here

# Models: the agent runs on the stronger model and falls back to the default one
OPENAI_MODEL=gpt-5.6-luna
OPENAI_SMART_MODEL=gpt-5.6-terra

# Signs login sessions. Generate one with:  python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string

# Unlocks the staff endpoints (/api/staff/purchase-list, /api/staff/inventory-checks)
STAFF_KEY=replace-with-another-long-random-string

# How often the inventory audit runs, in seconds (3600 = hourly)
INVENTORY_CHECK_SECONDS=3600

# Only needed for scripts/check_auth.py and scripts/check_shop.py: the seeded test user from the data pack
SEED_TEST_EMAIL=test-user-email-from-the-data-pack
SEED_TEST_PASSWORD=test-user-password-from-the-assignment
