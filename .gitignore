# ---- Local-only data pack: never commit the database or product images ----
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite

# ---- Secrets: only .env.example (placeholders) is committed ----
.env
.env.*
!.env.example

# ---- Python ----
.venv/
venv/
__pycache__/
*.pyc

# ---- Node / Vite ----
node_modules/
dist/
frontend/public/zz_*

# ---- Audit trail temp/corrupt copies (the trail itself, output/audit_trail.json, IS committed) ----
output/*.json.tmp
output/audit_trail.corrupt-*.json

# ---- OS / editor clutter ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
